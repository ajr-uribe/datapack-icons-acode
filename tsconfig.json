{
  "$schema": "file:///sch/tsconfig",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "strict": false,
    "moduleResolution": "bundler",
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/acode-plugin-types"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "node_modules/acode-plugin-types/**/*.d.ts"
  ]
}
